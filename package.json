		"@testing-library/react": "^16.2.0",
		"@types/node": "^20",
		"@types/react": "^18",
		"@types/react-dom": "^18",
		"eslint": "^8",
		"eslint-config-next": "14.2.15",
		"husky": "^9.1.7",
